{
	"name": "d-mais",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"scripts": {
		"dev": "cross-env APP_VARIANT=development npx expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"tsc": "npx tsc -noEmit",
		"lint": "npx @biomejs/biome check .",
		"format": "npx @biomejs/biome format --write .",
		"format:check": "npx @biomejs/biome format --check .",
		"biome": "npx @biomejs/biome",
		"eas:dev": "eas build --platform android --profile development",
		"eas:prev": "eas build --platform android --profile preview",
		"up:prev": "npx eas update --channel preview --message",
		"prepare": "husky"
	},
	"dependencies": {
		"@expo/vector-icons": "^15.0.3",
		"@hookform/resolvers": "^5.2.2",
		"@react-navigation/bottom-tabs": "^7.4.0",
		"@react-navigation/elements": "^2.6.3",
		"@react-navigation/native": "^7.1.8",
		"@shopify/restyle": "^2.4.5",
		"@tanstack/react-query": "^5.96.2",
		"axios": "^1.16.1",
		"expo": "~54.0.34",
		"expo-constants": "~18.0.13",
		"expo-dev-client": "~6.0.21",
		"expo-font": "~14.0.11",
		"expo-haptics": "~15.0.8",
		"expo-image": "~3.0.11",
		"expo-linking": "~8.0.12",
		"expo-router": "~6.0.23",
		"expo-splash-screen": "~31.0.13",
		"expo-status-bar": "~3.0.9",
		"expo-symbols": "~1.0.8",
		"expo-system-ui": "~6.0.9",
		"expo-updates": "~29.0.18",
		"expo-web-browser": "~15.0.11",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-hook-form": "^7.72.1",
		"react-native": "0.81.5",
		"react-native-gesture-handler": "~2.28.0",
		"react-native-mmkv": "^4.3.1",
		"react-native-nitro-modules": "^0.35.6",
		"react-native-reanimated": "~4.1.1",
		"react-native-safe-area-context": "~5.6.0",
		"react-native-screens": "~4.16.0",
		"react-native-svg": "^15.12.1",
		"react-native-web": "~0.21.0",
		"react-native-worklets": "0.5.1",
		"zod": "^4.3.6",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@types/react": "~19.1.0",
		"cross-env": "^10.1.0",
		"eslint": "^9.25.0",
		"eslint-config-expo": "~10.0.0",
		"eslint-plugin-import": "^2.32.0",
		"husky": "^9.1.7",
		"typescript": "~5.9.2"
	},
	"private": true
}
